// Copy to Config/Ripple.xcconfig and fill in your Apple Developer Team ID.
// Ripple.xcconfig is gitignored so contributors can use their own IDs.

DEVELOPMENT_TEAM =
PRODUCT_BUNDLE_IDENTIFIER = de.stefansturm.ripple
RIPPLE_APP_GROUP = group.de.stefansturm.ripple
RIPPLE_ICLOUD_CONTAINER = iCloud.de.stefansturm.ripple
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 1.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
IPHONEOS_DEPLOYMENT_TARGET = 26.0
WATCHOS_DEPLOYMENT_TARGET = 26.0
MACOSX_DEPLOYMENT_TARGET = 26.0
TVOS_DEPLOYMENT_TARGET = 26.0
XROS_DEPLOYMENT_TARGET = 26.0
